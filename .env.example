# Public benefit list/detail API key issued by data.go.kr
DATA_GO_KR_SERVICE_KEY=replace-with-your-service-key

# Optional PostgreSQL configuration. Omit these values to use local in-memory H2.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ansimlife
SPRING_DATASOURCE_USERNAME=ansimlife
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Use true only behind HTTPS.
SESSION_COOKIE_SECURE=false
